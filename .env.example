# ROLEX AI — Environment configuration
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# --- Policy ---
ROLEX_ONLY_MODE=false          # true = local intelligence only, block external AI
ALLOW_EXTERNAL_AI=true         # allow external providers when keys are present
REQUIRE_APPROVAL=true          # require human approval for sensitive actions

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Ollama (local server) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Hugging Face ---
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Picovoice (wake word) ---
PICOVOICE_ACCESS_KEY=

# --- Weather ---
OPENWEATHER_API_KEY=
DEFAULT_LOCATION=Chennai

# --- Network ---
HTTP_TIMEOUT=20
HTTP_RETRIES=2

# --- Voice ---
WAKE_WORD=hey rolex
WAKE_WORDS=hey rolex,hey guru
VOICE_ENABLED=true
TTS_RATE=175

# --- Smart-home / IoT ---
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Messaging / social ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=

# --- Remote Lab (WebSocket) ---
REMOTE_LAB_ENABLED=false
REMOTE_LAB_PORT=8765
REMOTE_LAB_TOKEN=

# --- Security ---
ROLEX_SECRET_KEY=change-me-to-a-long-random-string
BIOMETRIC_ENABLED=true
EMERGENCY_STOP_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
